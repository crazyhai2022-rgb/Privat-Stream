# viralX — environment template.
# Copy to server/.env (or export these in your host) and fill in the values you need.
# Everything below has a working development default except the ones marked REQUIRED IN PRODUCTION.

# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public base URL of the site. Verification and reset links are built from it, and it is the
# only Origin accepted for state-changing requests.
BASE_URL=http://localhost:4000
# Extra origins allowed to call the API (comma separated). Usually empty.
ALLOWED_ORIGINS=
# Set to true only when the app runs behind a reverse proxy you control (nginx, Caddy, a load
# balancer). It makes the app trust X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# REQUIRED IN PRODUCTION. 32+ random characters. Used to HMAC anonymous reaction identifiers
# and IP hashes. Changing it resets anonymous reaction identities.
#   generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ---------- Database ----------
# REQUIRED IN PRODUCTION. Without it, development falls back to an embedded PostgreSQL (PGlite)
# stored in server/.data/pglite so `npm start` works with zero setup.
# NOTE: the embedded database allows ONE process at a time — stop the server before running
# `npm run seed` or `npm run create-admin`, or set DATABASE_URL to a real PostgreSQL server.
DATABASE_URL=
# postgres://user:password@host:5432/viralx
DATABASE_SSL=false

# ---------- Sessions ----------
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=8
# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=

# ---------- Object storage ----------
# local  = files on this server's disk (development, or a single server with a persistent disk)
# s3     = any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
TMP_DIR=./tmp
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some self-hosted gateways
S3_FORCE_PATH_STYLE=false

# ---------- Email ----------
# Needed for email verification and password resets. Without SMTP in development, messages are
# written to the email_outbox table and the link is printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="viralX <no-reply@example.com>"

# ---------- Video processing ----------
# Run the processing worker inside the API process. Set to false if you run a separate worker.
RUN_WORKER=true
# Re-encode uploads to one streaming rendition. Turn off only if your uploads are already
# web-ready; thumbnails and duration checks still run.
TRANSCODE=true
# mp4 = H.264/AAC, the broadest compatibility. webm = VP9/Opus, for builds of Chromium without H.264.
PLAYBACK_FORMAT=mp4
WORKER_POLL_MS=1500
WORKER_MAX_ATTEMPTS=3

# ---------- Development helpers (must stay false in production) ----------
# Exposes GET /api/dev/outbox so you can read verification links without an SMTP server.
EXPOSE_EMAIL_OUTBOX=
RATE_LIMIT_DISABLED=false
