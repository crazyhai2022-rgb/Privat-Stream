# viralX — environment template.
# Copy to server/.env (or export these in your host) and fill in the values you need.
# Everything below has a working development default except the ones marked REQUIRED IN PRODUCTION.

# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public base URL of the site. Verification and reset links are built from it, and it is the
# only Origin accepted for state-changing requests.
BASE_URL=http://localhost:4000
# Extra origins allowed to call the API (comma separated). Usually empty.
ALLOWED_ORIGINS=
# Set to true only when the app runs behind a reverse proxy you control (nginx, Caddy, a load
# balancer). It makes the app trust X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# REQUIRED IN PRODUCTION. 32+ random characters. Used to HMAC anonymous reaction identifiers
# and IP hashes. Changing it resets anonymous reaction identities.
#   generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ---------- Database ----------
# REQUIRED IN PRODUCTION. Without it, development falls back to an embedded PostgreSQL (PGlite)
# stored in server/.data/pglite so `npm start` works with zero setup.
# NOTE: the embedded database allows ONE process at a time — stop the server before running
# `npm run seed` or `npm run create-admin`, or set DATABASE_URL to a real PostgreSQL server.
DATABASE_URL=
# postgres://user:password@host:5432/viralx
DATABASE_SSL=false
# Allows the embedded database in production. Only for a single small server: one process at
# a time, and no pg_dump (back it up by copying PGLITE_DIR).
ALLOW_EMBEDDED_DB=false
# Where the embedded database lives. Keep it OUTSIDE the repository so git pull cannot touch it.
PGLITE_DIR=

# ---------- Sessions ----------
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=8
# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=

# ---------- Object storage ----------
# local  = files on this server's disk (development, or a single server with a persistent disk)
# s3     = any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
TMP_DIR=./tmp
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some self-hosted gateways
S3_FORCE_PATH_STYLE=false

# ---------- Email ----------
# Needed for email verification and password resets. Without SMTP in development, messages are
# written to the email_outbox table and the link is printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="viralX <no-reply@example.com>"
# Set to "log" to write verification and reset links to the server log instead of sending
# them, so sign-up works before SMTP is configured. The links never go over HTTP.
MAIL_TRANSPORT=smtp

# ---------- Video processing ----------
# Where ffmpeg and ffprobe live. On shared hosting without root, install static builds with
# deploy/install-ffmpeg-static.sh and point these at them.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Set to false ONLY if ffmpeg cannot be installed: uploads are then accepted without
# thumbnails, without server-side duration limits, and only MP4/WebM will play.
REQUIRE_FFMPEG=true
# Run the processing worker inside the API process. Set to false if you run a separate worker.
RUN_WORKER=true
# Re-encode uploads to one streaming rendition. Turn off only if your uploads are already
# web-ready; thumbnails and duration checks still run.
TRANSCODE=true
# mp4 = H.264/AAC, the broadest compatibility. webm = VP9/Opus, for builds of Chromium without H.264.
PLAYBACK_FORMAT=mp4
WORKER_POLL_MS=1500
WORKER_MAX_ATTEMPTS=3

# ---------- One-time admin bootstrap ----------
# Lets you create the FIRST Super Admin over HTTP when you have no shell (see docs/CPANEL.md).
# 24+ random characters. The endpoint disappears once a Super Admin exists — delete this after.
ADMIN_BOOTSTRAP_TOKEN=

# ---------- Development helpers (never on a reachable server) ----------
# Serves GET /api/dev/outbox with verification and password-reset links, for local development
# without SMTP. Anyone who can reach it can take over any account, so it is OFF by default,
# answers local requests only, and production refuses to start with it on.
EXPOSE_EMAIL_OUTBOX=false
RATE_LIMIT_DISABLED=false

# ---------- Creator payments ----------
# REQUIRED before creators can save payment details: 32+ random characters. Account identifiers (UPI ids,
# wallet addresses) are AES-256-GCM encrypted with a key derived from this. Back it up: if you lose it,
# stored payment details cannot be read and creators must add them again. Do not change it casually.
PAYOUT_ENCRYPTION_KEY=

# ---------- Research (SEO suggestions) ----------
# Optional. Without a key the Research page still works in a clearly labelled "template" mode
# built from the page's own title and text; with a key it produces AI-written suggestions.
ANTHROPIC_API_KEY=
RESEARCH_AI_MODEL=claude-haiku-5-5

# ---------- Background upkeep ----------
# Builds earnings from view events, approves entries after their review window and trims old analytics.
# Runs inside the app (and on API traffic, so it still happens on hosts that sleep idle apps).
# Set RUN_MAINTENANCE=false only if you run `node src/scripts/maintenance.js` from cron instead.
RUN_MAINTENANCE=true
MAINTENANCE_EVERY_MINUTES=60

# ---------- CDN (optional) ----------
# Put a CDN (Cloudflare, Bunny, CloudFront...) in front of this server with this server as its origin, then set
# its public https address here. Published videos and thumbnails are served from it, with cache headers and
# range requests the CDN understands. Unpublished videos always stay on the origin behind the access check.
# Removed videos can stay cached up to CDN_CACHE_SECONDS: purge the CDN if something must disappear at once.
CDN_BASE_URL=
CDN_CACHE_SECONDS=3600

